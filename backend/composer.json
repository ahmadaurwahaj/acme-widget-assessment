{
    "name": "acme/widget-basket",
    "description": "Acme Widget Co sales basket proof of concept",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.12"
    },
    "autoload": {
        "psr-4": {
            "Acme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
